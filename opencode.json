{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-4.5-air",
  "default_agent": "OpenAgent",
  "agent": {
    "general": {
      "model": "openrouter/minimax/minimax-m2.5:free"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "deny",
      "rmdir *": "ask",
      "dd *": "deny",
      "mkfs *": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "killall *": "deny",
      "sudo *": "deny",
      "su *": "deny"
    },
    "edit": "allow",
    "write": "allow",
    "skill": "allow"
  }
}