{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-4.7-flashx",
  "default_agent": "OpenAgent",
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rm -rf *": "deny",
      "rmdir *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "killall *": "deny",
      "sudo *": "deny",
      "su *": "deny"
    },
    "edit": "allow",
    "write": "allow"
  }
}